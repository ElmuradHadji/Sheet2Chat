@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ContactAdder.Models.VCardUploadViewModel

@{
    Layout = null;
    ViewData["Title"] = "WhatsApp Kontakt Meneceri";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --wa-green: #25D366;
            --wa-dark: #075E54;
            --wa-teal: #128C7E;
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            color: #f8fafc;
            padding: 2.5rem 1rem;
        }

        .main-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .dropzone-container {
            border: 2px dashed rgba(255, 255, 255, 0.2);
            border-radius: 18px;
            background: rgba(15, 23, 42, 0.5);
            padding: 2.5rem 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .dropzone-container:hover, .dropzone-container.dragover {
            border-color: var(--wa-green);
            background: rgba(37, 211, 102, 0.05);
            transform: translateY(-2px);
        }

        .contact-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 1rem;
            transition: all 0.25s ease;
            cursor: pointer;
            user-select: none;
        }

        .contact-card:hover {
            border-color: rgba(37, 211, 102, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .contact-card.selected {
            background: rgba(18, 140, 126, 0.12);
            border-color: var(--wa-green);
        }

        .avatar-circle {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, rgba(37, 211, 102, 0.2) 0%, rgba(18, 140, 126, 0.3) 100%);
            border: 1px solid rgba(37, 211, 102, 0.3);
            color: var(--wa-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .custom-chk {
            width: 20px;
            height: 20px;
            accent-color: var(--wa-green);
            cursor: pointer;
        }

        .btn-wa {
            background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
            transition: all 0.3s ease;
        }

        .btn-wa:hover {
            background: linear-gradient(135deg, #22bf5b 0%, #0e7065 100%);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.45);
        }

        .phone-badge {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #38bdf8;
            font-family: monospace;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.85rem;
        }

        .tag-badge {
            background: rgba(37, 211, 102, 0.15);
            color: #4ade80;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }
    </style>
</head>
<body>

<div class="main-container">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-white mb-2"><i class="bi bi-whatsapp text-success me-2"></i>WhatsApp Kontakt Meneceri</h2>
        <p class="text-secondary small mb-0">Excel faylından kontaktları seçin və <strong>"Ww EVS"</strong> formatında .vcf faylı kimi yükləyin</p>
    </div>

    @if (Model.Contacts == null || Model.Contacts.Count == 0)
    {
        <div class="glass-card p-4 p-md-5 mx-auto" style="max-width: 580px;">
            <form action="/Home/PreviewContacts" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5;"></div>

                <div class="dropzone-container mb-4" id="dropzone">
                    <input asp-for="ExcelFile" type="file" class="d-none" id="fileInput" accept=".xlsx" />
                    <div id="dropzoneContent">
                        <i class="bi bi-file-earmark-spreadsheet text-success display-4 mb-2 d-inline-block"></i>
                        <h6 class="fw-semibold text-white mb-1">Excel faylını seçin və ya bura atın</h6>
                        <p class="text-secondary small mb-0">Yalnız <code>.xlsx</code> formatı (A=Ad, B=Soyad, C=Nömrə)</p>
                    </div>
                    <div id="fileInfo" class="d-none mt-2">
                        <div class="d-inline-flex align-items-center bg-dark bg-opacity-50 px-3 py-2 rounded-pill border border-success border-opacity-50">
                            <i class="bi bi-filetype-xlsx text-success me-2 fs-5"></i>
                            <span id="fileName" class="text-white small fw-medium text-truncate" style="max-width: 250px;"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-wa w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-eye"></i>
                    <span>Kontaktları Oxu və Göstər</span>
                </button>
            </form>
        </div>
    }
    else
    {
        <form action="/Home/ExportSelected" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="glass-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check d-flex align-items-center m-0">
                        <input class="form-check-input custom-chk me-2" type="checkbox" id="selectAllCheckbox" checked />
                        <label class="form-check-label fw-semibold text-white cursor-pointer" for="selectAllCheckbox">
                            Bütün hamısını seç
                        </label>
                    </div>
                    <span class="badge bg-dark border border-secondary px-3 py-2 text-secondary" id="selectedCountBadge">
                        Seçilib: <span class="text-success fw-bold">@Model.Contacts.Count</span> / @Model.Contacts.Count
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Home/Index" class="btn btn-outline-secondary btn-sm rounded-3 d-flex align-items-center">
                        <i class="bi bi-arrow-left me-1"></i> Yeni Fayl
                    </a>
                    <button type="submit" class="btn btn-wa btn-sm d-flex align-items-center gap-2">
                        <i class="bi bi-download"></i>
                        <span>Seçilmişləri Yüklə (.vcf)</span>
                    </button>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @for (int i = 0; i < Model.Contacts.Count; i++)
                {
                    var initial = !string.IsNullOrEmpty(Model.Contacts[i].FirstName) ? Model.Contacts[i].FirstName.Substring(0, 1).ToUpper() : "?";

                    <input type="hidden" asp-for="Contacts[i].FirstName" />
                    <input type="hidden" asp-for="Contacts[i].LastName" />
                    <input type="hidden" asp-for="Contacts[i].FullName" />
                    <input type="hidden" asp-for="Contacts[i].PhoneNumber" />

                    <div class="col">
                        <div class="contact-card selected" onclick="toggleCard(this)">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-white mb-1 d-flex align-items-center gap-2">
                                            <span>@Model.Contacts[i].FirstName @Model.Contacts[i].LastName</span>
                                            <span class="tag-badge">Ww EVS</span>
                                        </div>
                                        <span class="phone-badge">
                                            <i class="bi bi-telephone-fill me-1" style="font-size: 0.75rem;"></i>@Model.Contacts[i].PhoneNumber
                                        </span>
                                    </div>
                                </div>
                                <div onclick="event.stopPropagation();">
                                    <input asp-for="Contacts[i].IsSelected" class="form-check-input custom-chk contact-checkbox" type="checkbox" onchange="updateCardState(this)" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </form>
    }

</div>

<script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');

    if (dropzone && fileInput) {
        dropzone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                document.getElementById('fileName').textContent = e.target.files[0].name;
                document.getElementById('dropzoneContent').classList.add('d-none');
                document.getElementById('fileInfo').classList.remove('d-none');
            }
        });

        ['dragenter', 'dragover'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropzone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropzone.classList.remove('dragover');
            });
        });

        dropzone.addEventListener('drop', (e) => {
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                document.getElementById('fileName').textContent = e.dataTransfer.files[0].name;
                document.getElementById('dropzoneContent').classList.add('d-none');
                document.getElementById('fileInfo').classList.remove('d-none');
            }
        });
    }

    function toggleCard(cardElement) {
        const checkbox = cardElement.querySelector('.contact-checkbox');
        checkbox.checked = !checkbox.checked;
        updateCardVisual(cardElement, checkbox.checked);
        updateCounters();
    }

    function updateCardState(checkbox) {
        const card = checkbox.closest('.contact-card');
        updateCardVisual(card, checkbox.checked);
        updateCounters();
    }

    function updateCardVisual(card, isChecked) {
        if (isChecked) {
            card.classList.add('selected');
        } else {
            card.classList.remove('selected');
        }
    }

    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function () {
            const allCheckboxes = document.querySelectorAll('.contact-checkbox');
            allCheckboxes.forEach(cb => {
                cb.checked = selectAllCheckbox.checked;
                const card = cb.closest('.contact-card');
                updateCardVisual(card, selectAllCheckbox.checked);
            });
            updateCounters();
        });
    }

    function updateCounters() {
        const total = document.querySelectorAll('.contact-checkbox').length;
        const selected = document.querySelectorAll('.contact-checkbox:checked').length;
        const badge = document.getElementById('selectedCountBadge');
        if (badge) {
            badge.innerHTML = `Seçilib: <span class="text-success fw-bold">${selected}</span> / ${total}`;
        }
        if (selectAllCheckbox) {
            selectAllCheckbox.checked = (total > 0 && selected === total);
        }
    }
</script>

</body>
</html>